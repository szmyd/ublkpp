diff --git a/lib/ublksrv.c b/lib/ublksrv.c
index 6472ebc..ac2ab62 100644
--- a/lib/ublksrv.c
+++ b/lib/ublksrv.c
@@ -912,6 +912,27 @@ static void ublksrv_queue_discard_io_pages(struct _ublksrv_queue *q)
 	unsigned int io_buf_size = cdev->dev_info.max_io_buf_bytes;
 	int i = 0;
 
+	/*
+	 * Only reclaim when every tag's uring_cmd is parked in the ring, i.e.
+	 * when no buffer is owned by an in-flight target I/O.
+	 *
+	 * cmd_inflight is incremented when a tag's FETCH/COMMIT command is
+	 * submitted and decremented when its CQE arrives (the point at which
+	 * the tag's request, and its buffer, are handed to the target).  So
+	 * cmd_inflight == q_depth exactly when the target owns nothing.
+	 *
+	 * Without this check, a backend that stalls -- e.g. an iSCSI transport
+	 * that loses its session -- goes CQE-silent with its entire queue in
+	 * flight, which is indistinguishable from an idle queue and trips the
+	 * idle timeout.  MADV_DONTNEED then zaps the mappings of buffers that
+	 * pinned, in-flight reads are still writing into: the DMA lands in the
+	 * now-orphaned physical pages while the next touch of the buffer faults
+	 * in a fresh zero page.  The I/O completes with a full-length success
+	 * carrying all-zero data, with no error reported anywhere.
+	 */
+	if (q->cmd_inflight < q->q_depth)
+		return;
+
 	for (i = 0; i < q->q_depth; i++)
 		madvise(q->ios[i].buf_addr, io_buf_size, MADV_DONTNEED);
 }
